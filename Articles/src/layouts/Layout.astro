---
const {
  title = 'Articles',
  description = 'Technical articles and notes.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import 'katex/dist/katex.min.css';

  :root {
    --bg: #0a0a0a;
    --panel: #111111;
    --panel-alt: #171717;
    --panel-soft: #1d1d1d;
    --border: rgba(255, 255, 255, 0.12);
    --text: #f5f5f5;
    --muted: #b8b8b8;
    --muted-strong: #d9d9d9;
    --white: #ffffff;
    --shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
    --radius: 22px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: Inter, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background:
      radial-gradient(circle at top, rgba(255, 255, 255, 0.07), transparent 28%),
      var(--bg);
    color: var(--text);
    line-height: 1.6;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
    display: block;
  }

  p,
  li {
    color: var(--muted);
  }

  h1,
  h2,
  h3,
  h4,
  p,
  ul,
  ol {
    margin-top: 0;
  }

  .container {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
  }

  main {
    padding-bottom: 4rem;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(18px);
    background: rgba(10, 10, 10, 0.7);
    border-bottom: 1px solid var(--border);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 76px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.72rem;
    color: var(--white);
    font-weight: 700;
  }

  .brand-mark {
    width: 12px;
    height: 12px;
    background: var(--white);
    border-radius: 50%;
    box-shadow: 0 0 0 5px rgba(255, 255, 255, 0.08);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .nav a {
    color: var(--muted);
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .nav a:hover,
  .nav a.is-active {
    color: var(--white);
  }

  .nav a.is-active {
    padding-bottom: 0.2rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.4);
  }

  .nav-button {
    padding: 0.85rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
    color: var(--white);
  }

  .section {
    padding: 5rem 0;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.15rem;
  }

  .eyebrow::before {
    content: '';
    width: 28px;
    height: 1px;
    background: rgba(255, 255, 255, 0.3);
  }

  .hero {
    padding-top: 4.5rem;
    padding-bottom: 3.5rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 2rem;
    align-items: center;
  }

  .hero h1 {
    font-size: clamp(2.8rem, 6vw, 5rem);
    line-height: 0.96;
    letter-spacing: -0.05em;
    margin-bottom: 1.25rem;
    max-width: 720px;
  }

  .hero p {
    font-size: 1.06rem;
    max-width: 640px;
    color: var(--muted);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .primary-button,
  .secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.96rem 1.35rem;
    font-weight: 600;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .primary-button {
    background: var(--white);
    color: var(--bg);
  }

  .secondary-button {
    border: 1px solid var(--border);
    color: var(--white);
    background: rgba(255, 255, 255, 0.02);
  }

  .primary-button:hover,
  .secondary-button:hover {
    transform: translateY(-1px);
  }

  .hero-panel {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.4rem;
    box-shadow: var(--shadow);
  }

  .metric-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1.3rem;
  }

  .metric {
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.02);
  }

  .metric strong {
    display: block;
    font-size: 1.5rem;
    color: var(--white);
    margin-bottom: 0.2rem;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .section-heading h2 {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    letter-spacing: -0.04em;
    margin: 0;
  }

  .section-heading p {
    max-width: 560px;
    margin: 0;
  }

  .card-grid,
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 1.3rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .card:hover {
    border-color: rgba(255, 255, 255, 0.22);
    transform: translateY(-2px);
  }

  .card-tag {
    display: inline-block;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.9rem;
  }

  .card h3 {
    font-size: 1.35rem;
    letter-spacing: -0.04em;
    color: var(--white);
    margin-bottom: 0.7rem;
  }

  .card p {
    margin-bottom: 1rem;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.82rem;
  }

  .showcase-panel {
    margin-top: 2rem;
    border-radius: 24px;
    border: 1px solid var(--border);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01));
    padding: clamp(1.5rem, 2vw, 2.2rem);
  }

  .showcase-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: end;
  }

  .showcase-row h3 {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    margin: 0;
    letter-spacing: -0.05em;
  }

  .post-item {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.4rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    border-radius: 20px;
  }

  .post-item .date {
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .post-item h3 {
    font-size: 1.3rem;
    letter-spacing: -0.03em;
    color: var(--white);
    margin: 0;
  }

  .post-item p {
    margin: 0;
  }

  .category-rail {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin: 0 0 2rem;
  }

  .category-pill {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.8rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted-strong);
    background: rgba(255, 255, 255, 0.02);
    font-size: 0.76rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .category-pill:hover {
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-1px);
  }

  .category-section {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .category-section:first-of-type {
    margin-top: 0;
    padding-top: 0;
    border-top: none;
  }

  .category-section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .category-section-header h3 {
    margin: 0;
    font-size: clamp(1.4rem, 2vw, 2rem);
    letter-spacing: -0.04em;
    color: var(--white);
  }

  .category-section-header span {
    color: var(--muted);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .posts-grid--compact {
    grid-template-columns: repeat(2, minmax(220px, 1fr));
  }

  .category-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .category-card {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.2rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .category-card:hover {
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-2px);
  }

  .category-card strong {
    display: block;
    color: var(--white);
    font-size: 1.15rem;
    letter-spacing: -0.03em;
    line-height: 1.35;
  }

  .category-card small {
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  article.post-content {
    padding: 4rem 0 5rem;
  }

  .article-layout {
    width: min(1280px, calc(100% - 1.5rem));
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-content: center;
    align-items: start;
    position: relative;
  }

  .article-shell {
    width: min(760px, calc(100% - 5rem));
    margin: 0 auto;
  }

  .toc-shell {
    position: fixed;
    left: max(1rem, calc((100vw - 1280px) / 2 - 150px));
    top: 120px;
    z-index: 8;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: 220px;
    transition: transform 0.25s ease;
  }

  .toc-trigger {
    appearance: none;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: transparent;
    color: var(--muted-strong);
    border-radius: 999px;
    padding: 0.4rem 0.72rem;
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    line-height: 1.1;
    cursor: pointer;
    transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  .toc-trigger:hover,
  .toc-trigger:focus-visible {
    border-color: rgba(255, 255, 255, 0.15);
    color: var(--white);
    transform: translateY(-1px);
  }

  .toc-panel {
    width: 220px;
    max-width: 220px;
    max-height: min(300px, 60vh);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    overflow: hidden;
    margin-top: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(15, 15, 15, 0.8);
    border-radius: 14px;
    backdrop-filter: blur(10px);
    transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.2s ease;
    transform: translateY(-4px);
  }

  .toc-shell:hover .toc-panel,
  .toc-shell:focus-within .toc-panel,
  .toc-shell.is-open .toc-panel {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    border-color: rgba(255, 255, 255, 0.12);
  }

  .toc-header {
    display: flex;
    align-items: center;
    padding: 0.7rem 0.8rem 0.45rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    color: var(--muted);
    font-size: 0.68rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .toc-list {
    position: relative;
    list-style: none;
    padding: 0.75rem 0.75rem 0.8rem 1rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    max-height: calc(min(300px, 60vh) - 44px);
    overflow-y: auto;
    scrollbar-width: thin;
    scrollbar-color: rgba(255, 255, 255, 0.18) transparent;
  }

  .toc-list::before {
    content: '';
    position: absolute;
    left: 0.52rem;
    top: 0.7rem;
    bottom: 0.7rem;
    width: 1px;
    background: rgba(255, 255, 255, 0.08);
  }

  .toc-list::-webkit-scrollbar {
    width: 5px;
  }

  .toc-list::-webkit-scrollbar-thumb {
    background: rgba(255, 255, 255, 0.16);
    border-radius: 999px;
  }

  .toc-item {
    list-style: none;
    position: relative;
  }

  .toc-link {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.38rem 0.1rem 0.38rem 0.05rem;
    color: var(--muted);
    line-height: 1.35;
    font-size: 0.78rem;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .toc-link::before {
    content: '';
    width: 10px;
    height: 1px;
    background: rgba(255, 255, 255, 0.14);
    flex-shrink: 0;
    transition: width 0.2s ease, background 0.2s ease;
  }

  .toc-link:hover,
  .toc-link.is-active {
    color: var(--white);
    transform: translateX(1px);
  }

  .toc-link:hover::before,
  .toc-link.is-active::before {
    width: 16px;
    background: rgba(255, 255, 255, 0.75);
  }

  .toc-link-text {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    color: inherit;
  }

  .toc-depth-2 .toc-link {
    padding-left: 0.08rem;
  }

  .toc-depth-3 .toc-link {
    padding-left: 0.2rem;
    font-size: 0.74rem;
  }

  .toc-depth-4 .toc-link {
    padding-left: 0.35rem;
    font-size: 0.72rem;
  }

  .article-body h2,
  .article-body h3,
  .article-body h4 {
    scroll-margin-top: 110px;
  }

  .category-sidebar {
    position: fixed;
    right: max(1rem, calc((100vw - 1280px) / 2 - 190px));
    top: 120px;
    z-index: 7;
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    transition: transform 0.25s ease;
  }

  .category-toggle {
    appearance: none;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(255, 255, 255, 0.02);
    color: var(--white);
    width: 36px;
    height: 36px;
    border-radius: 12px;
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: border-color 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .category-toggle:hover {
    border-color: rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.04);
    transform: translateY(-1px);
  }

  .category-toggle-icon {
    font-size: 1rem;
    line-height: 1;
  }

  .category-panel {
    width: 0;
    max-width: 0;
    opacity: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    background: rgba(15, 15, 15, 0.94);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(14px);
    transition: width 0.25s ease, max-width 0.25s ease, opacity 0.2s ease;
  }

  .category-sidebar.is-open .category-panel {
    width: 250px;
    max-width: 250px;
    opacity: 1;
  }

  .category-header {
    padding: 0.8rem 0.9rem 0.65rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    color: var(--muted);
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .category-header-label {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .category-list {
    list-style: none;
    padding: 0.5rem;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    max-height: 420px;
    overflow-y: auto;
  }

  .category-list li {
    width: 100%;
  }

  .category-list a {
    display: block;
    padding: 0.6rem 0.7rem;
    border-radius: 10px;
    color: var(--muted);
    border: 1px solid transparent;
    transition: color 0.2s ease, border-color 0.2s ease, background 0.2s ease;
    line-height: 1.4;
    font-size: 0.82rem;
  }

  .category-list a:hover,
  .category-list a.is-current {
    color: var(--white);
    border-color: rgba(255, 255, 255, 0.16);
    background: rgba(255, 255, 255, 0.04);
  }

  .article-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
    margin-top: 1.8rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
  }

  .article-nav-card {
    display: flex;
    flex-direction: column;
    gap: 0.14rem;
    padding: 0.7rem 0.8rem;
    border-radius: 12px;
    border: 1px solid transparent;
    background: transparent;
    color: var(--white);
    text-decoration: none;
    position: relative;
    transition: border-color 0.2s ease, transform 0.2s ease, color 0.2s ease;
  }

  .article-nav-card:hover {
    border-color: rgba(255, 255, 255, 0.12);
    color: var(--white);
    transform: translateY(-1px);
  }

  .article-nav-card--disabled {
    opacity: 0.58;
    pointer-events: none;
  }

  .article-nav-label {
    color: var(--muted);
    font-size: 0.58rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .article-nav-card strong {
    font-size: 0.9rem;
    letter-spacing: -0.02em;
    line-height: 1.35;
  }

  .article-nav-card small {
    display: none;
  }

  .article-nav-arrow {
    position: absolute;
    right: 0.7rem;
    bottom: 0.6rem;
    font-size: 0.9rem;
    color: var(--muted-strong);
  }

  .article-header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }

  .article-header .meta {
    display: inline-flex;
    gap: 0.8rem;
    align-items: center;
    flex-wrap: wrap;
    color: var(--muted);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .article-header h1 {
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
    margin: 0.9rem 0 0;
  }

  .article-body {
    font-size: 1.08rem;
    color: var(--muted-strong);
  }

  .article-body h2,
  .article-body h3,
  .article-body h4 {
    color: var(--white);
    margin-top: 2.1rem;
    margin-bottom: 0.9rem;
    letter-spacing: -0.04em;
    scroll-margin-top: 110px;
  }

  .series-nav {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .series-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .series-header h3 {
    margin: 0;
    font-size: 1.2rem;
    color: var(--white);
  }

  .series-actions {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .series-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 120px;
    padding: 0.8rem 1rem;
    border-radius: 999px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.02);
    color: var(--white);
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .series-button:hover {
    border-color: rgba(255, 255, 255, 0.22);
    transform: translateY(-1px);
  }

  .series-button.disabled {
    opacity: 0.4;
    pointer-events: none;
  }

  .article-body p,
  .article-body li {
    color: var(--muted);
    margin-bottom: 1.1rem;
  }

  .article-body img {
    border-radius: 18px;
    border: 1px solid var(--border);
    margin: 1.5rem 0;
    background: rgba(255, 255, 255, 0.02);
  }

  .article-body a {
    color: var(--white);
    text-decoration: underline;

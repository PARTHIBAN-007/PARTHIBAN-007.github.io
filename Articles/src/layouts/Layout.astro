
---
const {
  title = 'Articles',
  description = 'Technical articles and notes.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      window.MathJax = {
        tex: {
          inlineMath: [['$', '$'], ['\\(', '\\)']],
          displayMath: [['$$', '$$'], ['\\[', '\\]']],
          processEscapes: true,
        },
        options: {
          skipHtmlTags: ['script', 'noscript', 'style', 'textarea', 'pre', 'code'],
        },
        chtml: {
          scale: 1,
        },
      };
    </script>
    <script
      defer
      src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"
    ></script>
  </head>

  <body>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    --color-bg: #0a0a0a;
    --color-bg-elevated: #111111;
    --color-bg-hover: #191919;
    --color-border: rgba(255,255,255,.1);
    --color-border-strong: rgba(255,255,255,.2);
    --color-text: #f5f5f5;
    --color-text-muted: #a0a0a0;
    --color-text-strong: #d9d9d9;
    --color-accent: #ffffff;

    --header-height: 72px;
    --content-max-width: 760px;
    --sidebar-width: 280px;
    --toc-width: 260px;

    --radius-sm: 8px;
    --radius-md: 12px;
    --radius-lg: 16px;

    --shadow-md: 0 8px 24px rgba(0,0,0,.3);
    --shadow-lg: 0 20px 48px rgba(0,0,0,.5);

    --transition-fast: 150ms ease;
    --transition-base: 250ms ease;

    --z-header: 100;
    --z-backdrop: 150;
    --z-drawer: 200;
  }

  *, *::before, *::after {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
    scroll-padding-top: 100px;
    -webkit-text-size-adjust: 100%;
  }

  html, body {
    margin: 0;
    padding: 0;
    min-height: 100%;
    overflow-x: clip;
  }

  body {
    font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background:
      radial-gradient(ellipse at top, rgba(255,255,255,.05), transparent 40%),
      var(--color-bg);
    color: var(--color-text);
    line-height: 1.7;
    font-size: 1rem;
    -webkit-font-smoothing: antialiased;
  }

  button, a {
    font: inherit;
  }

  button {
    color: inherit;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img, video, iframe {
    max-width: 100%;
  }

  img {
    height: auto;
  }

  h1, h2, h3, h4, h5, h6 {
    color: var(--color-accent);
    line-height: 1.25;
    font-weight: 700;
  }

  p, li {
    color: var(--color-text-strong);
  }

  button:focus-visible,
  a:focus-visible {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  [hidden] {
    display: none !important;
  }

  /* HEADER */

  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    height: var(--header-height);
    background: rgba(10,10,10,.88);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid var(--color-border);
  }

  .site-header-inner {
    max-width: 1400px;
    height: 100%;
    margin: auto;
    padding: 0 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: .75rem;
    color: white;
    font-size: .7rem;
    font-weight: 700;
    letter-spacing: .15em;
    text-transform: uppercase;
  }

  .brand-mark {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: white;
    box-shadow: 0 0 0 4px rgba(255,255,255,.08);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .nav-link {
    color: var(--color-text-muted);
    font-size: .875rem;
    font-weight: 500;
    position: relative;
    transition: color var(--transition-fast);
  }

  .nav-link:hover,
  .nav-link[aria-current="page"] {
    color: white;
  }

  .nav-link::after {
    content: "";
    position: absolute;
    bottom: -5px;
    left: 0;
    height: 2px;
    width: 0;
    background: white;
    transition: width var(--transition-base);
  }

  .nav-link:hover::after,
  .nav-link[aria-current="page"]::after {
    width: 100%;
  }

  .nav-toggle {
    display: none;
    width: 42px;
    height: 42px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-elevated);
    cursor: pointer;
    place-items: center;
  }

  .nav-toggle-icon {
    width: 20px;
    height: 2px;
    background: white;
    position: relative;
  }

  .nav-toggle-icon::before,
  .nav-toggle-icon::after {
    content: "";
    position: absolute;
    left: 0;
    width: 20px;
    height: 2px;
    background: white;
    transition: transform var(--transition-base);
  }

  .nav-toggle-icon::before { top: -7px; }
  .nav-toggle-icon::after { top: 7px; }

  .mobile-category-toggle {
    display: none;
    width: 42px;
    height: 42px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    background: var(--color-bg-elevated);
    cursor: pointer;
    place-items: center;
    color: white;
    transition: background var(--transition-fast), border-color var(--transition-fast);
  }

  .mobile-category-toggle:hover {
    background: var(--color-bg-hover);
    border-color: var(--color-border-strong);
  }

  .mobile-category-toggle svg {
    width: 20px;
    height: 20px;
  }

  /* MAIN ARTICLE */

  main {
    padding-bottom: 4rem;
  }

  .article-page {
    padding-top: 2rem;
  }

  .article-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    width: min(100% - 3rem, var(--content-max-width));
    margin: auto;
  }

  .article-content {
    width: 100%;
    min-width: 0;
    margin: 0 auto;
  }

  .article-header {
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--color-border);
  }

  .article-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: center;
    margin-bottom: 1.25rem;
    color: var(--color-text-muted);
    font-size: .75rem;
    font-weight: 500;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .article-title {
    font-size: clamp(2rem, 4.5vw, 3.5rem);
    line-height: 1.1;
    letter-spacing: -.03em;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .article-body {
    min-width: 0;
    font-size: 1.0625rem;
    line-height: 1.85;
    overflow-wrap: break-word;
  }

  .article-body h1,
  .article-body h2,
  .article-body h3,
  .article-body h4 {
    scroll-margin-top: calc(var(--header-height) + 24px);
    line-height: 1.3;
  }

  .article-body h1 { font-size: 2rem; margin-top: 2.5rem; }
  .article-body h2 { font-size: 1.75rem; margin-top: 3rem; }
  .article-body h3 { font-size: 1.375rem; margin-top: 2.5rem; }
  .article-body h4 { font-size: 1.125rem; margin-top: 2rem; }

  .article-body p {
    margin-bottom: 1.5rem;
  }

  .article-body ul,
  .article-body ol {
    padding-left: 1.75rem;
    margin-bottom: 1.5rem;
  }

  .article-body li {
    margin-bottom: .5rem;
  }

  .article-body a {
    color: white;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .article-body a:hover {
    opacity: .7;
  }

  .article-body blockquote {
    border-left: 3px solid var(--color-border-strong);
    padding-left: 1.5rem;
    margin: 1.5rem 0;
    color: var(--color-text-muted);
  }

  /* CENTERED RESPONSIVE IMAGES */

  .article-body img {
    display: block;
    width: auto;
    max-width: 100%;
    max-height: 75vh;
    height: auto;
    object-fit: contain;
    margin: 2rem auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }

  .article-body figure {
    margin: 2rem auto;
    width: 100%;
    text-align: center;
  }

  .article-body figure img {
    margin: 0 auto;
  }

  .article-body figcaption {
    color: var(--color-text-muted);
    font-size: .85rem;
    margin-top: .75rem;
  }

  .article-body pre {
    max-width: 100%;
    overflow-x: auto;
    padding: 1.25rem;
    background: rgba(0,0,0,.4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    margin: 1.5rem 0;
  }

  .article-body pre code {
    background: none;
    border: 0;
    padding: 0;
    font-size: .875rem;
    line-height: 1.6;
  }

  .article-body code {
    font-family: "JetBrains Mono", "Fira Code", monospace;
    font-size: .9em;
    background: rgba(255,255,255,.06);
    border: 1px solid var(--color-border);
    border-radius: 4px;
    padding: .15em .4em;
  }

  .article-body table {
    width: 100%;
    border-collapse: collapse;
    display: block;
    overflow-x: auto;
    margin: 1.5rem 0;
    border: 1px solid var(--color-border);
    font-size: .875rem;
  }

  .article-body th,
  .article-body td {
    padding: .625rem .75rem;
    border: 1px solid var(--color-border);
    text-align: left;
    min-width: 80px;
    white-space: nowrap;
  }

  .article-body th {
    background: var(--color-bg-elevated);
    color: white;
  }

  .article-body hr {
    border: 0;
    border-top: 1px solid var(--color-border);
    margin: 3rem 0;
  }

  mjx-container[display="true"] {
    display: block !important;
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    margin: 1.5rem 0 !important;
    padding: .5rem 0;
    text-align: center;
  }

  mjx-container:not([display="true"]) {
    display: inline-block;
  }

  /* PREVIOUS / NEXT */

  .article-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border);
  }

  .article-nav-link {
    display: flex;
    flex-direction: column;
    gap: .5rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-elevated);
    transition: all var(--transition-base);
    min-width: 0;
  }

  .article-nav-link:hover {
    border-color: var(--color-border-strong);
    background: var(--color-bg-hover);
    transform: translateY(-2px);
  }

  .article-nav-label {
    color: var(--color-text-muted);
    font-size: .7rem;
    text-transform: uppercase;
    letter-spacing: .1em;
  }

  .article-nav-link strong {
    color: white;
    font-size: .9rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .article-nav-disabled {
    opacity: .4;
    pointer-events: none;
  }

  /* DESKTOP FLOATING PANEL BUTTONS */

  .reading-panel-toggle {
    position: fixed;
    z-index: 120;
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    background: var(--color-bg-elevated);
    color: white;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    cursor: pointer;
    transition: background var(--transition-fast);
  }

  .reading-panel-toggle:hover {
    background: var(--color-bg-hover);
  }

  .reading-panel-toggle svg {
    width: 21px;
    height: 21px;
  }

  .reading-panel-toggle--left {
    top: calc(var(--header-height) + 16px);
    left: 16px;
  }

  .reading-panel-toggle--right {
    top: calc(var(--header-height) + 16px);
    right: 16px;
  }

  /* DESKTOP PANELS */

  .reading-panel {
    position: fixed;
    top: calc(var(--header-height) + 16px);
    width: 260px;
    max-height: min(70vh, 650px);
    overflow-y: auto;
    padding: 1rem;
    background: var(--color-bg-elevated);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    z-index: 110;
    scrollbar-width: thin;
    scrollbar-color: var(--color-border) transparent;
  }

  .reading-panel--left {
    left: 68px;
  }

  .reading-panel--right {
    right: 68px;
  }

  .reading-panel-heading {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: .75rem;
    padding-bottom: .75rem;
    margin-bottom: .75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .reading-panel-heading h2 {
    margin: 0;
    font-size: .75rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: .1em;
  }

  .panel-close {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
    border-radius: 7px;
    background: var(--color-bg-hover);
    color: white;
    font-size: 1.25rem;
    line-height: 1;
    cursor: pointer;
  }

  .panel-close:hover {
    background: #292929;
  }

  /* CATEGORY LIST */

  .category-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: .25rem;
  }

  .category-link {
    display: block;
    padding: .65rem .75rem;
    border-radius: var(--radius-sm);
    color: var(--color-text-strong);
    font-size: .8rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
    transition: background var(--transition-fast);
  }

  .category-link:hover {
    background: var(--color-bg-hover);
    color: white;
  }

  .category-link.is-current {
    background: rgba(255,255,255,.08);
    color: white;
    border-left: 2px solid white;
  }

  /* TABLE OF CONTENTS */

  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: .2rem;
  }

  .toc-item {
    margin: 0;
    padding: 0;
  }

  .toc-item--depth-1 { padding-left: 0; }
  .toc-item--depth-2 { padding-left: .75rem; }
  .toc-item--depth-3 { padding-left: 1.5rem; }
  .toc-item--depth-4 { padding-left: 2.25rem; }

  .toc-link {
    display: flex;
    align-items: flex-start;
    gap: .5rem;
    padding: .4rem .5rem;
    border-left: 2px solid transparent;
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--color-text-muted);
    font-size: .76rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
    transition: all var(--transition-fast);
  }

  .toc-level {
    flex-shrink: 0;
    color: #777;
    font-size: .68rem;
    font-weight: 600;
    letter-spacing: .03em;
  }

  .toc-link:hover {
    color: white;
    background: var(--color-bg-hover);
  }

  .toc-link.is-active {
    color: white;
    border-left-color: white;
    background: rgba(255,255,255,.06);
  }

  .toc-link.is-active .toc-level {
    color: white;
  }

  /* MOBILE DRAWER */

  .drawer-backdrop {
    position: fixed;
    inset: 0;
    z-index: var(--z-backdrop);
    background: rgba(0,0,0,.65);
    backdrop-filter: blur(4px);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity var(--transition-base), visibility var(--transition-base);
  }

  .drawer-backdrop.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  .category-drawer {
    position: fixed;
    z-index: var(--z-drawer);
    top: 0;
    bottom: 0;
    left: 0;
    width: min(75vw, 300px);
    background: var(--color-bg-elevated);
    border-right: 1px solid var(--color-border);
    box-shadow: var(--shadow-lg);
    transform: translateX(-105%);
    visibility: hidden;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition: transform var(--transition-base), visibility var(--transition-base);
  }

  .category-drawer.is-open {
    transform: translateX(0);
    visibility: visible;
  }

  .drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: .75rem;
    padding: 1rem;
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
  }

  .drawer-title {
    margin: 0;
    font-size: .8rem;
    font-weight: 600;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: .1em;
  }

  .drawer-close {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex-shrink: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-bg-hover);
    color: white;
    cursor: pointer;
  }

  .drawer-close svg {
    width: 20px;
    height: 20px;
  }

  .drawer-content {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: .75rem;
    overscroll-behavior: contain;
  }

  .drawer-category-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: .3rem;
  }

  .drawer-category-link {
    display: block;
    padding: .75rem;
    font-size: .8rem;
    line-height: 1.5;
    color: var(--color-text-strong);
    border: 1px solid transparent;
    border-radius: var(--radius-md);
    overflow-wrap: anywhere;
  }

  .drawer-category-link:hover {
    background: var(--color-bg-hover);
  }

  .drawer-category-link.is-current {
    background: rgba(255,255,255,.07);
    border-color: var(--color-border);
    color: white;
  }

  /* MOBILE FLOATING OPEN BUTTON */

  /* BODY STATE */

  body.drawer-is-open {
    overflow: hidden;
    touch-action: none;
  }

  /* TABLET */

  @media (max-width: 1200px) {
    .reading-panel {
      width: 230px;
    }

    .reading-panel--left {
      left: 64px;
    }

    .reading-panel--right {
      right: 64px;
    }
  }

  /* MOBILE */

  @media (max-width: 1024px) {
    :root {
      --header-height: 64px;
    }

    .article-grid {
      width: min(100% - 2rem, var(--content-max-width));
    }

    .reading-panel-toggle,
    .reading-panel {
      display: none !important;
    }

    .mobile-category-toggle {
      display: grid;
    }

    .mobile-category-toggle[hidden] {
      display: none !important;
    }

    .category-drawer {
      width: min(48vw, 300px);
      min-width: 220px;
    }

    .article-page {
      padding-top: 1.5rem;
    }

    .article-title {
      font-size: clamp(1.75rem, 6vw, 2.5rem);
    }

    .article-body {
      font-size: 1rem;
      line-height: 1.8;
    }

    .article-body h1 { font-size: 1.7rem; }
    .article-body h2 { font-size: 1.5rem; }
    .article-body h3 { font-size: 1.25rem; }
    .article-body h4 { font-size: 1.0625rem; }

    .article-body img {
      max-height: 65vh;
      margin: 1.5rem auto;
    }

    .article-nav {
      grid-template-columns: 1fr;
    }

    .article-nav-link {
      padding: .75rem;
    }

    .article-nav-label {
      font-size: .6rem;
    }

    .article-nav-link strong {
      font-size: .8rem;
      line-height: 1.4;
    }

    .nav-toggle {
      display: none;
    }

    .nav {
      position: static;
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 2rem;
      padding: 0;
      background: transparent;
      border: 0;
      opacity: 1;
      visibility: visible;
      transform: none;
    }

    .nav-link {
      padding: 0;
    }
  }

  @media (max-width: 480px) {
    .site-header-inner {
      padding: 0 1rem;
    }

    .article-grid {
      width: calc(100% - 2rem);
    }

    .category-drawer {
      width: min(75vw, 280px);
      min-width: 0;
    }

    .article-meta {
      font-size: .68rem;
    }

    .article-body {
      font-size: .97rem;
    }

    .article-body pre {
      padding: .9rem;
      font-size: .8rem;
    }

    .article-body table {
      font-size: .75rem;
    }

    .article-body th,
    .article-body td {
      padding: .5rem .5rem;
      min-width: 60px;
    }
  }

  /* REDUCED MOTION */

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      animation-duration: .01ms !important;
      transition-duration: .01ms !important;
    }
  }

  /* PRINT */

  @media print {
    .site-header,

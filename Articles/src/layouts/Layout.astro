---
const {
  title = 'Parthiban | Portfolio & Blog',
  description = 'A professional portfolio and technical blog focused on systems, AI, and engineering thinking.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @import 'katex/dist/katex.min.css';

  :root {
    --bg: #0a0a0a;
    --panel: #111111;
    --panel-alt: #171717;
    --panel-soft: #1d1d1d;
    --border: rgba(255, 255, 255, 0.12);
    --text: #f5f5f5;
    --muted: #b8b8b8;
    --muted-strong: #d9d9d9;
    --white: #ffffff;
    --shadow: 0 30px 80px rgba(0, 0, 0, 0.35);
    --radius: 22px;
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: Inter, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    background:
      radial-gradient(circle at top, rgba(255, 255, 255, 0.07), transparent 28%),
      var(--bg);
    color: var(--text);
    line-height: 1.6;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  img {
    max-width: 100%;
    display: block;
  }

  p,
  li {
    color: var(--muted);
  }

  h1,
  h2,
  h3,
  h4,
  p,
  ul,
  ol {
    margin-top: 0;
  }

  .container {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    backdrop-filter: blur(18px);
    background: rgba(10, 10, 10, 0.7);
    border-bottom: 1px solid var(--border);
  }

  .site-header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 76px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-size: 0.72rem;
    color: var(--white);
    font-weight: 700;
  }

  .brand-mark {
    width: 12px;
    height: 12px;
    background: var(--white);
    border-radius: 50%;
    box-shadow: 0 0 0 5px rgba(255, 255, 255, 0.08);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    flex-wrap: wrap;
  }

  .nav a {
    color: var(--muted);
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .nav a:hover {
    color: var(--white);
  }

  .nav-button {
    padding: 0.85rem 1.2rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
    color: var(--white);
  }

  .section {
    padding: 5rem 0;
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.72rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.15rem;
  }

  .eyebrow::before {
    content: '';
    width: 28px;
    height: 1px;
    background: rgba(255, 255, 255, 0.3);
  }

  .hero {
    padding-top: 4.5rem;
    padding-bottom: 3.5rem;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: 2rem;
    align-items: center;
  }

  .hero h1 {
    font-size: clamp(2.8rem, 6vw, 5rem);
    line-height: 0.96;
    letter-spacing: -0.05em;
    margin-bottom: 1.25rem;
    max-width: 720px;
  }

  .hero p {
    font-size: 1.06rem;
    max-width: 640px;
    color: var(--muted);
  }

  .hero-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .primary-button,
  .secondary-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.96rem 1.35rem;
    font-weight: 600;
    transition: transform 0.2s ease, border-color 0.2s ease;
  }

  .primary-button {
    background: var(--white);
    color: var(--bg);
  }

  .secondary-button {
    border: 1px solid var(--border);
    color: var(--white);
    background: rgba(255, 255, 255, 0.02);
  }

  .primary-button:hover,
  .secondary-button:hover {
    transform: translateY(-1px);
  }

  .hero-panel {
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.4rem;
    box-shadow: var(--shadow);
  }

  .metric-grid {
    display: grid;
    gap: 1rem;
    margin-top: 1.3rem;
  }

  .metric {
    padding: 1rem 1.1rem;
    border: 1px solid var(--border);
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.02);
  }

  .metric strong {
    display: block;
    font-size: 1.5rem;
    color: var(--white);
    margin-bottom: 0.2rem;
  }

  .section-heading {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .section-heading h2 {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    letter-spacing: -0.04em;
    margin: 0;
  }

  .section-heading p {
    max-width: 560px;
    margin: 0;
  }

  .card-grid,
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(220px, 1fr));
    gap: 1.25rem;
  }

  .card {
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 1.3rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .card:hover {
    border-color: rgba(255, 255, 255, 0.22);
    transform: translateY(-2px);
  }

  .card-tag {
    display: inline-block;
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.9rem;
  }

  .card h3 {
    font-size: 1.35rem;
    letter-spacing: -0.04em;
    color: var(--white);
    margin-bottom: 0.7rem;
  }

  .card p {
    margin-bottom: 1rem;
  }

  .card-meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1rem;
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.82rem;
  }

  .showcase-panel {
    margin-top: 2rem;
    border-radius: 24px;
    border: 1px solid var(--border);
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.03), rgba(255, 255, 255, 0.01));
    padding: clamp(1.5rem, 2vw, 2.2rem);
  }

  .showcase-row {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    align-items: end;
  }

  .showcase-row h3 {
    font-size: clamp(1.8rem, 3vw, 2.6rem);
    margin: 0;
    letter-spacing: -0.05em;
  }

  .post-item {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    padding: 1.4rem;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    border-radius: 20px;
  }

  .post-item .date {
    color: var(--muted);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .post-item h3 {
    font-size: 1.3rem;
    letter-spacing: -0.03em;
    color: var(--white);
    margin: 0;
  }

  .post-item p {
    margin: 0;
  }

  article.post-content {
    padding: 4rem 0 5rem;
  }

  .article-shell {
    width: min(850px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .article-header {
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--border);
    margin-bottom: 2rem;
  }

  .article-header .meta {
    display: inline-flex;
    gap: 0.8rem;
    align-items: center;
    flex-wrap: wrap;
    color: var(--muted);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .article-header h1 {
    font-size: clamp(2.4rem, 5vw, 4rem);
    line-height: 1.05;
    letter-spacing: -0.05em;
    margin: 0.9rem 0 0;
  }

  .article-body {
    font-size: 1.08rem;
    color: var(--muted-strong);
  }

  .article-body h2,
  .article-body h3,
  .article-body h4 {
    color: var(--white);
    margin-top: 2.1rem;
    margin-bottom: 0.9rem;
    letter-spacing: -0.04em;
  }

  .article-body p,
  .article-body li {
    color: var(--muted);
    margin-bottom: 1.1rem;
  }

  .article-body img {
    border-radius: 18px;
    border: 1px solid var(--border);
    margin: 1.5rem 0;
    background: rgba(255, 255, 255, 0.02);
  }

  .article-body a {
    color: var(--white);
    text-decoration: underline;
    text-underline-offset: 0.14em;
  }

  .article-body code {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.15rem 0.38rem;
    color: var(--white);
  }

  .article-body pre {
    overflow-x: auto;
    padding: 1rem;
    border-radius: 16px;
    border: 1px solid var(--border);
    background: rgba(255, 255, 255, 0.03);
  }

  .article-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
  }

  .article-body th,
  .article-body td {
    border: 1px solid var(--border);
    padding: 0.8rem 0.9rem;
    text-align: left;
    vertical-align: top;
  }

  .article-body th {
    background: rgba(255, 255, 255, 0.04);
    color: var(--white);
  }

  .article-body .katex-display {
    overflow-x: auto;
    overflow-y: hidden;
    margin: 1.5rem 0;
  }

  .page-footer {
    border-top: 1px solid var(--border);
    padding: 2rem 0 3rem;
    color: var(--muted);
  }

  .page-footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: center;
    flex-wrap: wrap;
  }

  @media (max-width: 860px) {
    .hero-grid,
    .card-grid,
    .posts-grid {
      grid-template-columns: 1fr;
    }

    .section-heading {
      display: block;
    }

    .section-heading p {
      margin-top: 0.8rem;
    }
  }

  @media (max-width: 560px) {
    .site-header-inner {
      flex-direction: column;
      justify-content: center;
      padding: 0.9rem 0;
    }

    .nav {
      justify-content: center;
    }

    .hero {
      padding-top: 3rem;
    }
  }
</style>


---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const getPostSlug = (post: { id: string }) =>
  post.id.replace(/\.(md|mdx)$/i, '');

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  function getPostSlug(post) {
  return post.id.replace(/\.(md|mdx)$/i, '');
}

  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content, headings = [] } = await render(post);

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Include H1 (#) through H4 (####).
const tocItems = headings.filter(
  (heading) => heading.depth >= 1 && heading.depth <= 4,
);

const category = post.data.category || 'General';

const categoryPosts = posts.filter(
  (item) => (item.data.category || 'General') === category,
);

const currentTopicIndex = categoryPosts.findIndex(
  (item) => item.id === post.id,
);

const previousPost =
  currentTopicIndex > 0 ? categoryPosts[currentTopicIndex - 1] : null;

const nextPost =
  currentTopicIndex >= 0 && currentTopicIndex < categoryPosts.length - 1
    ? categoryPosts[currentTopicIndex + 1]
    : null;

const isHome = Astro.url.pathname === '/';
const isArticles = Astro.url.pathname.startsWith('/blog');

const formatDate = (date: Date) =>
  new Date(date).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
---

<Layout title={post.data.title} description={post.data.description}>

  <header class="site-header">
    <div class="site-header-inner">
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="main-nav"
        aria-label="Toggle navigation menu"
        data-nav-toggle
      >
        <span class="nav-toggle-icon"></span>
      </button>

      {categoryPosts.length > 1 && (
        <button
          class="mobile-category-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="category-drawer"
          aria-label="Open article navigation"
          data-mobile-category-toggle
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <path d="M4 5h16M4 12h16M4 19h16" />
          </svg>
        </button>
      )}

      <a href="/" class="brand" aria-label="Articles Home">
        <span class="brand-mark" aria-hidden="true"></span>
        Articles
      </a>

      <nav class="nav" id="main-nav" aria-label="Main navigation">
        <a href="/" class="nav-link" aria-current={isHome ? 'page' : undefined}>Home</a>
        <a href="/blog" class="nav-link" aria-current={isArticles ? 'page' : undefined}>Articles</a>
      </nav>
    </div>
  </header>

  <main class="article-page">
    <div class="article-grid">

      <article class="article-content">

        <header class="article-header">
          <div class="article-meta">
            <span class="article-category">{category}</span>
            <time datetime={post.data.date.toISOString()}>
              {formatDate(post.data.date)}
            </time>
          </div>

          <h1 class="article-title">{post.data.title}</h1>
        </header>

        <div class="article-body">
          <Content />
        </div>

        {(previousPost || nextPost) && (
          <nav class="article-nav" aria-label="Previous and next articles">
            {previousPost ? (
              <a href={`/blog/${getPostSlug(previousPost)}`} class="article-nav-link" rel="prev">
                <span class="article-nav-label">← Previous</span>
                <strong>{previousPost.data.title}</strong>
              </a>
            ) : (
              <span class="article-nav-link article-nav-disabled">
                <span class="article-nav-label">← Previous</span>
                <strong>Start of series</strong>
              </span>
            )}

            {nextPost ? (
              <a href={`/blog/${getPostSlug(nextPost)}`} class="article-nav-link" rel="next">
                <span class="article-nav-label">Next →</span>
                <strong>{nextPost.data.title}</strong>
              </a>
            ) : (
              <span class="article-nav-link article-nav-disabled">
                <span class="article-nav-label">Next →</span>
                <strong>End of series</strong>
              </span>
            )}
          </nav>
        )}

      </article>
    </div>
  </main>

  {/* DESKTOP ARTICLE NAVIGATION */}

  {categoryPosts.length > 1 && (
    <>
      <button
        class="reading-panel-toggle reading-panel-toggle--left"
        type="button"
        aria-label="Open article navigation"
        aria-expanded="false"
        aria-controls="desktop-category-panel"
        data-panel-toggle="category"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 5h16M4 12h16M4 19h16" />
        </svg>
      </button>

      <aside
        class="reading-panel reading-panel--left"
        id="desktop-category-panel"
        aria-label={`Articles in ${category}`}
        data-reading-panel="category"
        hidden
      >
        <div class="reading-panel-heading">
          <h2>{category}</h2>

          <button
            type="button"
            class="panel-close"
            aria-label="Close article navigation"
            data-desktop-category-close
          >
            ×
          </button>
        </div>

        <ul class="category-list">
          {categoryPosts.map((item) => (
            <li class="category-item">
              <a
                href={`/blog/${getPostSlug(item)}`}
                class:list={[
                  'category-link',
                  { 'is-current': item.id === post.id },
                ]}
                aria-current={item.id === post.id ? 'page' : undefined}
              >
                {item.data.title}
              </a>
            </li>
          ))}
        </ul>
      </aside>
    </>
  )}

{/* DESKTOP TABLE OF CONTENTS */}

  {tocItems.length > 0 && (
    <>
      <button
        class="reading-panel-toggle reading-panel-toggle--right"
        type="button"
        aria-label="Show table of contents"
        aria-expanded="false"
        aria-controls="desktop-toc-panel"
        data-panel-toggle="toc"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <rect x="3" y="4" width="18" height="16" rx="2" />
          <path d="M9 8h8M9 12h8M9 16h5M6 8h.01M6 12h.01M6 16h.01" />
        </svg>
      </button>

      <aside
        class="reading-panel reading-panel--right"
        id="desktop-toc-panel"
        aria-label="Table of contents"
        data-reading-panel="toc"
        hidden
      >
        <div class="reading-panel-heading">
          <h2>Contents</h2>
          <button
            type="button"
            class="panel-close"
            aria-label="Close table of contents"
            data-toc-close
          >
            ×
          </button>
        </div>

        <ul class="toc-list">
          {tocItems.map((heading) => (
            <li class:list={['toc-item', `toc-item--depth-${heading.depth}`]}>
              <a
                class="toc-link"
                href={`#${heading.slug}`}
                data-heading-id={heading.slug}
                title={heading.text}
              >
                <span>{heading.text}</span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    </>
  )}

  {/* MOBILE ARTICLE NAVIGATION (Left side drawer) */}

  {categoryPosts.length > 1 && (
    <>
      <div class="drawer-backdrop" data-drawer-backdrop aria-hidden="true"></div>

      <aside
        class="category-drawer"
        id="category-drawer"
        role="dialog"
        aria-modal="true"
        aria-label={`Articles in ${category}`}
        aria-hidden="true"
        data-category-drawer
        inert
      >
        <div class="drawer-header">
          <h2 class="drawer-title">{category}</h2>

          <button
            class="drawer-close"
            type="button"
            aria-label="Close article navigation"
            data-drawer-close
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
              <path d="M18 6 6 18M6 6l12 12" />
            </svg>
          </button>
        </div>

        <div class="drawer-content">
          <ul class="drawer-category-list">
            {categoryPosts.map((item) => (
              <li>
                <a
                  href={`/blog/${getPostSlug(item)}`}
                  class:list={[
                    'drawer-category-link',
                    { 'is-current': item.id === post.id },
                  ]}
                  aria-current={item.id === post.id ? 'page' : undefined}
                >
                  {item.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </>
  )}

  <script>
    const CATEGORY_NAV_KEY = 'articles-category-navigation-open';

    const desktopView = window.matchMedia('(min-width: 1025px)');

    const desktopToggle = document.querySelector<HTMLButtonElement>(
      '[data-panel-toggle="category"]'
    );

    const desktopPanel = document.querySelector<HTMLElement>(
      '[data-reading-panel="category"]'
    );

    const desktopClose = document.querySelector<HTMLButtonElement>(
      '[data-desktop-category-close]'
    );

    const mobileToggle = document.querySelector<HTMLButtonElement>(
      '[data-mobile-category-toggle]'
    );

    const mobileDrawer = document.querySelector<HTMLElement>(
      '[data-category-drawer]'
    );

    const drawerBackdrop = document.querySelector<HTMLElement>(
      '[data-drawer-backdrop]'
    );

    const drawerClose = document.querySelector<HTMLButtonElement>(
      '[data-drawer-close]'
    );

    function getSavedState(): boolean {
      try {
        return sessionStorage.getItem(CATEGORY_NAV_KEY) === 'true';
      } catch {
        return false;
      }
    }

    function saveState(open: boolean) {
      try {
        sessionStorage.setItem(CATEGORY_NAV_KEY, String(open));
      } catch {
        // Storage unavailable.
      }
    }

    function updateNavigation() {
      const open = getSavedState();
      const isDesktop = desktopView.matches;
      const showDesktop = open && isDesktop;
      const showMobile = open && !isDesktop;

      if (desktopPanel) {
        desktopPanel.hidden = !showDesktop;
        desktopPanel.classList.toggle('is-open', showDesktop);
      }

      if (desktopToggle) {
        desktopToggle.hidden = !isDesktop || showDesktop;
        desktopToggle.setAttribute('aria-expanded', String(showDesktop));
      }

      if (mobileDrawer) {
        mobileDrawer.classList.toggle('is-open', showMobile);
        mobileDrawer.setAttribute('aria-hidden', String(!showMobile));
        mobileDrawer.inert = !showMobile;
      }

      if (drawerBackdrop) {
        drawerBackdrop.classList.toggle('is-open', showMobile);
      }

      // The floating open button must disappear while the drawer is open.
      if (mobileToggle) {
        mobileToggle.hidden = showMobile || isDesktop;
        mobileToggle.setAttribute('aria-expanded', String(showMobile));
      }

      document.body.classList.toggle('drawer-is-open', showMobile);
    }

    function setNavigation(open: boolean) {
      saveState(open);
      updateNavigation();
    }

    desktopToggle?.addEventListener('click', () => {
      setNavigation(true);
    });

    desktopClose?.addEventListener('click', () => {
      setNavigation(false);
    });

    mobileToggle?.addEventListener('click', () => {
      setNavigation(true);
    });

    drawerClose?.addEventListener('click', () => {
      setNavigation(false);
      mobileToggle?.focus();
    });

    drawerBackdrop?.addEventListener('click', () => {
      setNavigation(false);
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobileDrawer?.classList.contains('is-open')) {
        setNavigation(false);
        mobileToggle?.focus();
      }
    });

    desktopView.addEventListener('change', updateNavigation);

    // Restore navigation state on article load.
    updateNavigation();

    // TOC controls.
    const tocToggle = document.querySelector<HTMLButtonElement>(
      '[data-panel-toggle="toc"]'
    );

    const tocPanel = document.querySelector<HTMLElement>(
      '[data-reading-panel="toc"]'
    );

    const tocClose = document.querySelector<HTMLButtonElement>(
      '[data-toc-close]'
    );

    function setToc(open: boolean) {
      if (!tocPanel || !tocToggle) return;

      tocPanel.hidden = !open;
      tocPanel.classList.toggle('is-open', open);
      tocToggle.hidden = open;

      tocToggle.setAttribute('aria-expanded', String(open));
      tocToggle.setAttribute(
        'aria-label',
        open ? 'Hide table of contents' : 'Show table of contents'
      );
    }

    tocToggle?.addEventListener('click', () => setToc(true));
    tocClose?.addEventListener('click', () => setToc(false));

    // Active section tracking.
    const tocLinks = Array.from(
      document.querySelectorAll<HTMLAnchorElement>('.toc-link')
    );

    const tocSections = tocLinks
      .map((link) => {
        const id = link.dataset.headingId;
        const target = id ? document.getElementById(id) : null;
        return target ? { link, target } : null;
      })
      .filter((item): item is NonNullable<typeof item> => item !== null);

    if ('IntersectionObserver' in window && tocSections.length) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort(
              (a, b) =>
                a.boundingClientRect.top - b.boundingClientRect.top
            );

          if (!visible.length) return;

          const activeId = visible[0].target.id;

          tocLinks.forEach((link) => {
            const active = link.dataset.headingId === activeId;
            link.classList.toggle('is-active', active);

            if (active) {
              link.setAttribute('aria-current', 'location');
            } else {
              link.removeAttribute('aria-current');
            }
          });
        },
        {
          rootMargin: '-100px 0px -65% 0px',
          threshold: [0, 0.1, 0.25, 0.5],
        }
      );

      tocSections.forEach(({ target }) => observer.observe(target));
    }
  </script>

</Layout>

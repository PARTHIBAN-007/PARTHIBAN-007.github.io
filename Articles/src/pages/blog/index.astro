---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<Layout title="Articles | Parthiban" description="Thoughtful writing on systems, software engineering, and technical strategy.">
  <header class="site-header">
    <div class="container site-header-inner">
      <a href="/" class="brand">
        <span class="brand-mark"></span>
        Parthiban
      </a>
      <nav class="nav" aria-label="Main navigation">
        <a href="/">Home</a>
        <a href="/#work">Work</a>
        <a href="/blog">Articles</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="section">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Writing</span>
            <h2>Technical articles and notes.</h2>
          </div>
          <p>
            Short, structured explainers on software systems, GPU architecture, and the thinking behind engineering decisions.
          </p>
        </div>

        <div class="posts-grid">
          {posts.map((post) => (
            <article class="post-item">
              <div class="date">{new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</div>
              <div class="card-tag">{post.data.category}</div>
              <h3>
                <a href={`/blog/${post.id.replace(/\.md$/, '')}`}>
                  {post.data.title}
                </a>
              </h3>
              <p>{post.data.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="page-footer">
    <div class="container page-footer-inner">
      <span>© 2026 Parthiban</span>
      <span>Built for clarity, systems, and thoughtful execution.</span>
    </div>
  </footer>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const groupedPosts = Object.entries(
  posts.reduce((acc, post) => {
    const category = post.data.category || 'General';
    acc[category] ??= [];
    acc[category].push(post);
    return acc;
  }, {} as Record<string, typeof posts>),
).map(([category, categoryPosts]) => ({
  category,
  posts: categoryPosts,
}));
const slugify = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
const isArticles = currentPath.startsWith('/blog');
---

<Layout title="Articles" description="Short technical articles and notes on software, systems, and engineering.">
  <header class="site-header">
    <div class="container site-header-inner">
      <a href="/" class="brand">
        <span class="brand-mark"></span>
        Articles
      </a>
      <nav class="nav" aria-label="Main navigation">
        <a href="/" class:list={{ 'nav-link': true, 'is-active': isHome }} aria-current={isHome ? 'page' : undefined}>Home</a>
        <a href="/blog" class:list={{ 'nav-link': true, 'is-active': isArticles }} aria-current={isArticles ? 'page' : undefined}>Articles</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="section">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Articles</span>
            <h2>Writing archive</h2>
          </div>
          <p>
            Short explainers and notes on systems, engineering decisions, and technical ideas.
          </p>
        </div>

        <div class="category-rail" aria-label="Browse topics">
          {groupedPosts.map(({ category }) => (
            <a href={`#category-${slugify(category)}`} class="category-pill">{category}</a>
          ))}
        </div>

        {groupedPosts.map(({ category, posts: categoryPosts }) => (
          <section id={`category-${slugify(category)}`} class="category-section">
            <div class="category-section-header">
              <h3>{category}</h3>
              <span>{categoryPosts.length} {categoryPosts.length === 1 ? 'article' : 'articles'}</span>
            </div>

            <div class="posts-grid posts-grid--compact">
              {categoryPosts.map((post) => (
                <article class="post-item">
                  <div class="date">{new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</div>
                  <div class="card-tag">{post.data.category}</div>
                  <h3>
                    <a href={`/blog/${post.id.replace(/\.md$/, '')}`}>
                      {post.data.title}
                    </a>
                  </h3>
                  <p>{post.data.description}</p>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>
  </main>

  <footer class="page-footer">
    <div class="container page-footer-inner">
      <span>Writing archive</span>
    </div>
  </footer>
</Layout>

---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const groupedPosts = Object.entries(
  posts.reduce((acc, post) => {
    const category = post.data.category || 'General';
    acc[category] ??= [];
    acc[category].push(post);
    return acc;
  }, {} as Record<string, typeof posts>),
).map(([category, categoryPosts]) => ({
  category,
  posts: categoryPosts,
}));
const slugify = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
const isArticles = currentPath.startsWith('/blog');

const formatDate = (date: Date) =>
  new Date(date).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
---

<Layout title="Articles" description="Technical notes on LLMs, GPUs, and model fine-tuning.">

  <header class="site-header">
    <div class="site-header-inner">
      <a href="/" class="brand" aria-label="Articles Home">
        <span class="brand-mark" aria-hidden="true"></span>
        Articles
      </a>
      <nav class="nav" aria-label="Main navigation">
        <a href="/" class="nav-link" aria-current={isHome ? 'page' : undefined}>Home</a>
        <a href="/blog" class="nav-link" aria-current={isArticles ? 'page' : undefined}>Articles</a>
      </nav>
    </div>
  </header>

  <main style="padding-bottom: 4rem;">
    <section style="padding: 3rem 1.5rem 2rem; max-width: 1400px; margin: 0 auto;">
      <div style="max-width: 760px; margin: 0 auto;">
        <span style="display: inline-block; color: var(--color-text-muted); font-size: .75rem; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; margin-bottom: .5rem;">Articles</span>
        <h2 style="font-size: clamp(2rem, 4vw, 3rem); line-height: 1.2; letter-spacing: -.02em; margin: 0 0 1rem; color: white;">Technical Notes</h2>
        <p style="color: var(--color-text-strong); font-size: 1.0625rem; line-height: 1.7; margin: 0 0 2rem;">Short explainers and notes on LLM architectures, GPU computing, and model fine-tuning.</p>

        <nav style="display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 3rem;" aria-label="Browse topics">
          {groupedPosts.map(({ category }) => (
            <a href={`#category-${slugify(category)}`} style="padding: .5rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); color: var(--color-text-strong); font-size: .8rem; font-weight: 500; background: var(--color-bg-elevated); transition: all var(--transition-fast);" onmouseover="this.style.borderColor='var(--color-border-strong)'; this.style.color='white'" onmouseout="this.style.borderColor='var(--color-border)'; this.style.color='var(--color-text-strong)'">{category}</a>
          ))}
        </nav>

        {groupedPosts.map(({ category, posts: categoryPosts }) => (
          <section id={`category-${slugify(category)}`} style="margin-bottom: 4rem;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
              <h3 style="font-size: 1.25rem; line-height: 1.3; margin: 0; color: white;">{category}</h3>
              <span style="color: var(--color-text-muted); font-size: .75rem; font-weight: 500;">{categoryPosts.length} {categoryPosts.length === 1 ? 'article' : 'articles'}</span>
            </div>

            <div style="display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));">
              {categoryPosts.map((post) => (
                <article style="border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 1.25rem; background: var(--color-bg-elevated); transition: all var(--transition-base);">
                  <h3 style="font-size: 1rem; line-height: 1.4; margin: 0 0 .5rem;">
                    <a href={`/blog/${post.id.replace(/\.md$/, '')}`} style="color: white; transition: opacity var(--transition-fast);" onmouseover="this.style.opacity='0.7'" onmouseout="this.style.opacity='1'">{post.data.title}</a>
                  </h3>
                  <p style="color: var(--color-text-muted); font-size: .8rem; line-height: 1.5; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{post.data.description}</p>
                </article>
              ))}
            </div>
          </section>
        ))}
      </div>
    </section>
  </main>

  <footer style="padding: 2rem 1.5rem; border-top: 1px solid var(--color-border); max-width: 1400px; margin: 0 auto;">
    <div style="max-width: 760px; margin: 0 auto; text-align: center; color: var(--color-text-muted); font-size: .8rem; font-weight: 500; letter-spacing: .08em; text-transform: uppercase;">Technical Notes</div>
  </footer>
</Layout>
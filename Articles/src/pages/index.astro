---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const groupedPosts = Object.entries(
  posts.reduce((acc, post) => {
    const category = post.data.category || 'General';
    acc[category] ??= [];
    acc[category].push(post);
    return acc;
  }, {} as Record<string, typeof posts>),
).map(([category, categoryPosts]) => ({
  category,
  posts: categoryPosts,
}));
const slugify = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
const isArticles = currentPath.startsWith('/blog');

const formatDate = (date: Date) =>
  new Date(date).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
  });
---

<Layout title="Home" description="Technical notes on LLMs, GPU , and model fine-tuning.">

  <header class="site-header">
    <div class="site-header-inner">
      <a href="/" class="brand" aria-label="Articles Home">
        <span class="brand-mark" aria-hidden="true"></span>
        Articles
      </a>
      <nav class="nav" aria-label="Main navigation">
        <a href="/" class="nav-link" aria-current={isHome ? 'page' : undefined}>Home</a>
        <a href="/blog" class="nav-link" aria-current={isArticles ? 'page' : undefined}>Articles</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="home-hero" style="padding: 4rem 1.5rem 3rem; max-width: 1400px; margin: 0 auto;">
      <div style="max-width: 760px; margin: 0 auto; text-align: center;">
        <span style="display: inline-block; color: var(--color-text-muted); font-size: .75rem; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; margin-bottom: 1rem;">Home</span>
        <h1 style="font-size: clamp(2.5rem, 5vw, 4rem); line-height: 1.1; letter-spacing: -.03em; margin: 0 0 1.5rem; color: white;">Technical notes on LLM Architectures and GPUs</h1>
        <p style="font-size: 1.125rem; color: var(--color-text-strong); line-height: 1.7; max-width: 600px; margin: 0 auto 2.5rem;">Short explainers, practical breakdowns, and technical writing focused on the ideas that matter.</p>
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
          <a href="/blog" style="display: inline-flex; align-items: center; gap: .5rem; padding: .875rem 1.5rem; background: white; color: #0a0a0a; font-weight: 600; font-size: .875rem; border-radius: var(--radius-md); transition: all var(--transition-fast);">Read articles</a>
          <a href="#latest" style="display: inline-flex; align-items: center; gap: .5rem; padding: .875rem 1.5rem; border: 1px solid var(--color-border); color: var(--color-text); font-weight: 500; font-size: .875rem; border-radius: var(--radius-md); transition: all var(--transition-fast); background: transparent;">Latest writing</a>
        </div>
      </div>
    </section>

    <section id="latest" style="padding: 2rem 1.5rem 4rem; max-width: 1400px; margin: 0 auto;">
      <div style="max-width: 760px; margin: 0 auto;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1.5rem; margin-bottom: 2rem; flex-wrap: wrap;">
          <div>
            <span style="display: inline-block; color: var(--color-text-muted); font-size: .75rem; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; margin-bottom: .5rem;">Latest</span>
            <h2 style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); line-height: 1.2; letter-spacing: -.02em; margin: 0; color: white;">Recent articles</h2>
          </div>
          <a href="/blog" style="display: inline-flex; align-items: center; gap: .5rem; padding: .75rem 1.25rem; border: 1px solid var(--color-border); color: var(--color-text); font-weight: 500; font-size: .875rem; border-radius: var(--radius-md); transition: all var(--transition-fast); background: transparent; margin-top: .5rem;">View all</a>
        </div>

        <div style="display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));">
          {posts.slice(0, 6).map((post) => (
            <article style="border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 1.5rem; background: var(--color-bg-elevated); transition: all var(--transition-base);">
              <h3 style="font-size: 1.125rem; line-height: 1.4; margin: 0 0 .75rem;">
                <a href={`/blog/${post.id.replace(/\.md$/, '')}`} style="color: white; transition: opacity var(--transition-fast);" onmouseover="this.style.opacity='0.7'" onmouseout="this.style.opacity='1'">{post.data.title}</a>
              </h3>
              <p style="color: var(--color-text-muted); font-size: .875rem; line-height: 1.6; margin: 0; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">{post.data.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer style="padding: 2rem 1.5rem; border-top: 1px solid var(--color-border); max-width: 1400px; margin: 0 auto;">
    <div style="max-width: 760px; margin: 0 auto; text-align: center; color: var(--color-text-muted); font-size: .8rem; font-weight: 500; letter-spacing: .08em; text-transform: uppercase;">Technical Notes</div>
  </footer>
</Layout>
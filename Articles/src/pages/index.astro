---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const groupedPosts = Object.entries(
  posts.reduce((acc, post) => {
    const category = post.data.category || 'General';
    acc[category] ??= [];
    acc[category].push(post);
    return acc;
  }, {} as Record<string, typeof posts>),
).map(([category, categoryPosts]) => ({
  category,
  posts: categoryPosts,
}));
const slugify = (value: string) => value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';
const isArticles = currentPath.startsWith('/blog');
---

<Layout title="Home" description="Notes and short technical articles on software and systems.">
  <header class="site-header">
    <div class="container site-header-inner">
      <a href="/" class="brand">
        <span class="brand-mark"></span>
        Articles
      </a>
      <nav class="nav" aria-label="Main navigation">
        <a href="/" class:list={{ 'nav-link': true, 'is-active': isHome }} aria-current={isHome ? 'page' : undefined}>Home</a>
        <a href="/blog" class:list={{ 'nav-link': true, 'is-active': isArticles }} aria-current={isArticles ? 'page' : undefined}>Articles</a>
      </nav>
    </div>
  </header>

  <main>
    <section class="section hero">
      <div class="container hero-grid">
        <div>
          <span class="eyebrow">Home</span>
          <h1>Clear notes on software, systems, and engineering.</h1>
          <p>
            Short explainers, practical breakdowns, and technical writing focused on the ideas that matter.
          </p>
          <div class="hero-actions">
            <a href="/blog" class="primary-button">Read articles</a>
            <a href="#latest" class="secondary-button">Latest writing</a>
          </div>
        </div>

        <div class="hero-panel">
          <span class="eyebrow">Now reading</span>
          <h2>Focused thinking for complex topics.</h2>
          <div class="metric-grid">
            <div class="metric">
              <strong>1</strong>
              <span>Writing archive</span>
            </div>
            <div class="metric">
              <strong>Simple</strong>
              <span>Clear structure</span>
            </div>
            <div class="metric">
              <strong>Fast</strong>
              <span>Easy to browse</span>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Topics</span>
            <h2>Browse by category</h2>
          </div>
          <a href="/blog" class="secondary-button">View archive</a>
        </div>

        <div class="category-cards">
          {groupedPosts.slice(0, 3).map(({ category, posts: categoryPosts }) => (
            <a href={`/blog#category-${slugify(category)}`} class="category-card">
              <span class="card-tag">{category}</span>
              <strong>{categoryPosts[0].data.title}</strong>
              <small>{categoryPosts.length} {categoryPosts.length === 1 ? 'article' : 'articles'}</small>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="latest" class="section">
      <div class="container">
        <div class="section-heading">
          <div>
            <span class="eyebrow">Latest</span>
            <h2>Recent articles</h2>
          </div>
          <a href="/blog" class="secondary-button">View all</a>
        </div>

        <div class="posts-grid">
          {posts.slice(0, 3).map((post) => (
            <article class="post-item">
              <div class="date">{new Date(post.data.date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</div>
              <div class="card-tag">{post.data.category}</div>
              <h3>
                <a href={`/blog/${post.id.replace(/\.md$/, '')}`}>
                  {post.data.title}
                </a>
              </h3>
              <p>{post.data.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  </main>

  <footer class="page-footer">
    <div class="container page-footer-inner">
      <span>Writing archive</span>
    </div>
  </footer>
</Layout>
